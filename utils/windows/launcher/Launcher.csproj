<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- AnyCPU runs 64-bit on this install's 64-bit Windows, but the
         WebView2 NuGet package only copies the native loader matching
         PlatformTarget, not the actual runtime bitness. Without this,
         GetAvailableBrowserVersionString() throws BadImageFormatException
         (0x8007000B) loading the wrong-bitness WebView2Loader.dll.
         Windows 10/11 is x64-only for the app's audience, so pin it
         instead of forcing 32-bit compatibility. -->
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ASEStudio</AssemblyName>
    <RootNamespace>AseStudio.Launcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- AppIcon.ico is added by the build workflow once the icon is ready. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
